{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acecog.org/schemas/v0.24/MembershipCredential.schema.json",
  "title": "MembershipCredential",
  "description": "Governed attestation that an Actor is a unique, eligible member of a Civic Body.",
  "x-acecog-object": "Membership Credential",
  "x-acecog-section": "7",
  "x-acecog-phase1": "build",
  "x-acecog-spec": "7, 17.5, 23.1.1",
  "x-acecog-engine": "membership_credential",
  "allOf": [
    {
      "$ref": "ObjectHeader.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "member_actor_id",
    "tier"
  ],
  "properties": {
    "member_actor_id": {
      "type": "string"
    },
    "identity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tier": {
      "enum": [
        "Provisional",
        "Vouched",
        "Documented",
        "Verified"
      ]
    },
    "attestation_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "revoked": {
      "type": "boolean"
    }
  }
}
