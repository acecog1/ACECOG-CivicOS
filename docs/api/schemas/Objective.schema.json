{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acecog.org/schemas/v0.24/Objective.schema.json",
  "title": "Objective",
  "description": "Approved outcome, value or optimization criterion.",
  "x-acecog-object": "Objective",
  "x-acecog-section": "7",
  "x-acecog-phase1": "build",
  "x-acecog-spec": "7, 5.3",
  "x-acecog-engine": null,
  "allOf": [
    {
      "$ref": "ObjectHeader.schema.json"
    }
  ],
  "type": "object",
